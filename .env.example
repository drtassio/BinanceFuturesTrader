# Copie para .env e preencha as chaves. O .env nunca vai para o git.

# --- Binance ---
# Chaves de PRODUCAO: o bot so le dados de mercado com elas (ordens bloqueadas).
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Chaves da TESTNET (https://testnet.binancefuture.com): as ordens vao para ca.
BINANCE_TESTNET="True"
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
PAPER_TRADING_PURE="False"

# --- Politica ao vivo: espelho dos agentes treinados ---
LIVE_POLICY=agent_mirror
LIVE_AGENTS=bull,bear
# Bear reprovado no holdout: opera so na testnet, para diagnostico (models_ai/shadow).
# O bot se recusa a iniciar com isto fora da testnet.
TESTNET_DIAGNOSTIC_AGENTS=bear

# --- Parametros usados no treino e na aprovacao ---
MAX_LEVERAGE_PER_TRADE=20.0
MIN_CONFIDENCE_FOR_LEVERAGE=0.75
SL_DIST_MULTIPLIER_MIN=0.5
SL_DIST_MULTIPLIER_MAX=3.0
SL_DIST_MULTIPLIER_MAX_VOLATILE=5.0
BACKTEST_WITH_EXPLANATIONS=False
FLASK_ENV="development"

# --- Opcionais ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=
SECRET_KEY=
SESSION_SECRET=
ENCRYPTION_KEY=
